# Copy to examples/.env and run:
#
#   cd <repo>/lib && npm run build
#   node --env-file=examples/.env examples/list-paid-campaigns.mjs
#
# Node 20.6+ is required for --env-file. Otherwise:
#   export SOUNDLINK_TOKEN=...
#   export SOUNDLINK_ORGANIZATION_ID=...
#   export SOUNDLINK_BASE_URL=...
#   node examples/list-paid-campaigns.mjs

SOUNDLINK_TOKEN=your_bearer_jwt_or_api_token
SOUNDLINK_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
SOUNDLINK_BASE_URL=https://your-api-host.example.com

# Optional
# SOUNDLINK_DEBUG=true
